{
  "name": "viettel-phu-ha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build && python3 -m http.server 3000 --bind 0.0.0.0 --directory dist",
    "dev": "npm start",
    "build": "python3 scripts/build-static.py",
    "test:api": "node --test tests/sheets.test.cjs",
